{
  "name": "shoe-shop-functional-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Avtomatizirano funkcionalno testiranje naloge 4",
  "engines": { "node": ">=22" },
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "e2e:db": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "e2e:db:stop": "docker compose -f docker-compose.e2e.yml down"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "mysql2": "3.24.6"
  }
}
